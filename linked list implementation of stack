class Node:
    def __init__(self,data):
        self.data=data
        self.next=None
class Stack:
    def __init__(self):
        self.top=None
    def is_empty(self):
        return self.top is None
    def push(self,data):
        new_node=Node(data)
        new_node.next=self.top
        self.top=new_node
        print(f"{data} is pushed")
    def pop(self):
        if self.is_empty():
            return None
        popped_data=self.top.data
        self.top=self.top.next
        return popped_data
stack=Stack()
n=int(input("Enter no of elements to push:"))
for i in range(n):
    p=int(input(f"Enter {i+1}:"))
    stack.push(p)
print("pop:",stack.pop())
